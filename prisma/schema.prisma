// Database schema. Change it, then run `npm run db:migrate -- --name <what_changed>`.
// Never hand-write files in prisma/migrations/: the Prisma CLI generates them.
// SQLite has no enums here, so allowed values (category, condition, status) are
// checked with Zod in src/data/schemas.ts before anything is written.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One physical item that can be leased, returned, refurbished and leased again.
// Mirrors data/assets.json; `usage` is stored as two columns.
model Asset {
  id             String   @id
  category       String // e_bike | laptop | farm_machine
  make           String
  model          String
  model_year     Int
  serial_number  String   @unique
  condition      String // new | like_new | good | fair | poor
  usage_unit     String // km | battery_cycles | engine_hours
  usage_value    Int
  previous_lives Int
  status         String // available | reserved | returned
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  contracts      Contract[]

  @@index([category])
}

// Who changed what, and when. Written in the same transaction as the change
// (see src/server/audit.ts), so a change without an audit row cannot exist.
model AuditLog {
  id           Int      @id @default(autoincrement())
  created_at   DateTime @default(now())
  actor        String
  action       String // e.g. asset.status_changed
  entity_type  String // e.g. asset
  entity_id    String
  details_json String? // JSON text, e.g. {"from":"available","to":"reserved"}

  @@index([entity_type, entity_id])
  @@index([created_at])
}

// Authentication identity is separate from the party owning future leases.
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("customer")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      AuthSession[]
  identities    AuthIdentity[]
  customer      Customer?
}

model Customer {
  id           String   @id
  ownerUserId  String   @unique
  owner        User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  contracts    Contract[]
}

// Contract amounts are the agreed net price snapshot, in whole euro cents.
// startDate is the first invoice date (YYYY-MM-DD); future invoices are forecasts.
model Contract {
  id                String   @id @default(cuid())
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assetId           String
  asset             Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  startDate         String
  termMonths        Int
  listPriceCents    Int
  downPaymentCents  Int
  monthlyNetCents   Int
  buyoutCents       Int
  priceListVersion  Int
  status            String   @default("active")
  isDemo            Boolean  @default(false)
  createdAt         DateTime @default(now())
  invoices          Invoice[]
  requests          LeaseRequest[]
  events            LeaseEvent[]

  @@index([customerId, status])
  @@index([assetId])
}

// Issued invoices retain their net and VAT snapshot even if the tax table changes.
model Invoice {
  id             String   @id @default(cuid())
  contractId     String
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  dueDate        String
  issuedDate     String
  netCents       Int
  vatBasisPoints Int
  vatCents       Int
  status         String   @default("issued")
  payments       Payment[]

  @@unique([contractId, dueDate])
}

// A payment is a recorded event; generating an invoice does not imply payment.
model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountCents Int
  paidDate    String
  isSimulated Boolean  @default(false)

  @@index([invoiceId])
}

model LeaseRequest {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  kind       String // return | buyout | exchange
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@index([contractId, status])
}

// Only customer-safe events are displayed. Never store previous customers' details.
model LeaseEvent {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  kind       String // signed | payment | returned | refurbished
  eventDate  String
  createdAt  DateTime @default(now())

  @@index([contractId, eventDate])
}

model AuthSession {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  @@index([userId])
}

model AuthIdentity {
  id                     String    @id
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId              String
  providerId             String
  password               String?
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId])
  @@unique([providerId, accountId])
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model AuthRateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}
