# Copied to .env by `npm run db:setup` if .env does not exist. Never commit .env.
# SQLite file, relative to the repository root.
DATABASE_URL="file:./dev.db"

# Exact application origin. Use HTTPS in production.
BETTER_AUTH_URL="http://localhost:3000"
# npm run auth:setup generates this locally. Never commit a real secret.
BETTER_AUTH_SECRET=""
